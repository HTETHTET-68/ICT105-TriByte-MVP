flowchart TD
    A([Start HallPass final demo]) --> B["Problem: campus information is scattered<br/>Target users: first-year, international, and exchange students"]
    B --> C["Landing page<br/>Value proposition + Try HallPass CTA"]
    C --> D["Homepage<br/>Recent activity, categories, search, saved-place access"]

    D --> E{"Choose a student pathway"}
    E --> F["Browse dormitory or cafeteria reviews<br/>Keyword search, category/minimum-rating filters, sort"]
    E --> G["Open Campus Survival Guide<br/>Browse and search practical topics"]
    E --> H["Sign up / log in<br/>Email and password validation"]

    F --> I["Place detail view<br/>Reviews, verification labels, helpful votes, price/distance, Google Maps link"]
    I --> J{"Save or compare a place?"}
    J -- "Save" --> K["Saved Places<br/>Compare 2–3 places + quick recommendations"]
    J -- "Continue" --> L{"Write a review?"}
    K --> L
    G --> M["Guide detail view<br/>Useful campus-life guidance"]

    H --> N["Review form<br/>Dormitory/cafeteria selection, rating, comment, consent"]
    L -- "Yes" --> N
    L -- "No" --> O["Student Dashboard<br/>Saved places, recently viewed, profile, notifications"]
    N --> P["Validate form and privacy consent<br/>Store review in browser localStorage"]
    P --> Q["Submission feedback<br/>New review starts as Pending"]
    Q --> O
    M --> O

    O --> R["Status and ownership controls<br/>Filter Pending/Approved/Rejected/Removal Requested;<br/>remove a pending item or request removal"]
    R --> S{"Report incorrect or unsafe content?"}
    S -- "Yes" --> T["Submit report<br/>Prevent duplicate open reports"]
    S -- "No" --> U["View student activity and dashboard summary"]
    T --> U

    U --> V["Administrator demonstration login"]
    V --> W["Admin Dashboard<br/>Moderation queue, operational metrics, reports, users, audit log"]
    W --> X{"Select an admin action"}
    X --> Y["Approve or reject review<br/>Process removal request"]
    X --> Z["Investigate report and record a decision"]
    X --> AA["Manage demonstration users<br/>Search, suspend/restore, delete"]
    Y --> AB["Persist moderation/status and audit action in localStorage"]
    Z --> AB
    AA --> AB
    AB --> AC["Return to Student Dashboard<br/>Show notification and updated status"]

    AC --> AD["Explain evidence<br/>Requirements, testing, metrics, responsible data handling,<br/>business value, limitations, and future secure-backend work"]
    AD --> AE([Close final venture pitch])

    classDef context fill:#fff4e5,stroke:#d97706,color:#7c2d12,stroke-width:2px;
    classDef student fill:#eaf2ff,stroke:#2563eb,color:#163b73,stroke-width:2px;
    classDef action fill:#ecfdf3,stroke:#16a34a,color:#14532d,stroke-width:2px;
    classDef admin fill:#f3e8ff,stroke:#7e22ce,color:#581c87,stroke-width:2px;
    classDef outcome fill:#0b3d91,stroke:#082f72,color:#ffffff,stroke-width:2px;

    class A,B,C context;
    class D,E,F,G,H,I,J,K,L,M,N,O,P,Q,R,S,T,U student;
    class V,W,X,Y,Z,AA admin;
    class AB,AC action;
    class AD,AE outcome;
